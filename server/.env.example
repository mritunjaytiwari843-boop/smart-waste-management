# MongoDB connection (local, or a MongoDB Atlas connection string)
MONGODB_URI=mongodb://127.0.0.1:27017/smart_waste
PORT=5000

# Secret used to sign login cookies. Use a long random string, for example:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required when NODE_ENV=production.
JWT_SECRET=

# Optional: an admin account created on startup (admins can advance report status).
# The password is only used when the account does not exist yet.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# Only needed if the React site is hosted on a different address than the API.
# CLIENT_ORIGIN=http://localhost:5173

# Seconds Truck 12 takes for one full loop of the route
LOOP_SECONDS=34
